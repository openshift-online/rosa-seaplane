{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:allDigest"],
  "enabledManagers": ["dockerfile", "gomod", "tekton"],
  "timezone": "UTC",
  "dockerfile": {
    "managerFilePatterns": ["/^Containerfile$/"]
  },
  "tekton": {
    "managerFilePatterns": ["/^\\.tekton\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Move from 2 segment to 3 segment version",
      "versioning": "loose",
      "matchPackageNames": ["/quay.io/konflux-ci//"]
    },
    {
      "description": "Batch + automerge patch/minor/digest Containerfile updates when Prow + Konflux pass",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "dockerfile dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": ["automerge", "dependencies", "docker"]
    },
    {
      "description": "Require manual review for major Containerfile updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies",
        "docker"
      ]
    },
    {
      "description": "Do not propose Go modules that require a newer toolchain than go.mod",
      "matchManagers": ["gomod"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Batch + automerge patch/minor/digest Go module updates when Prow + Konflux pass",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "gomod dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": ["automerge", "dependencies", "go-modules"]
    },
    {
      "description": "Require manual review for major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies",
        "go-modules"
      ]
    },
    {
      "description": "Batch + automerge Konflux Tekton reference updates when Prow + Konflux pass",
      "matchManagers": ["tekton"],
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "tekton dependencies",
      "schedule": ["* 2-4 * * 1-5"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "addLabels": ["automerge", "dependencies"]
    },
    {
      "description": "Require manual review for major Tekton updates",
      "matchManagers": ["tekton"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": [
        "major-update",
        "manual-review-required",
        "dependencies"
      ]
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false
}
