{
  "enable_pagerduty": {{ observability.pagerduty.enabled | default(false) | tojson }},
  "pagerduty_escalation_policy_id": {{ observability.pagerduty.escalation_policy_id | default('') | tojson }},
  "deployment_name": "{{ deployment_name }}",
  "app_code": "{{ terraform_tags.app_code }}",
  "service_phase": "{{ terraform_tags.service_phase }}",
  "cost_center": "{{ terraform_tags.cost_center }}",
  "enable_bastion": {{ regional_cluster.enable_bastion | default(false) | tojson }},
  "enable_rate_limit_redis": {{ regional_cluster.enable_rate_limit_redis | default(false) | tojson }},
  "seaplane_db_instance_class": {{ regional_cluster.seaplane_db_instance_class | default('db.r6g.large') | tojson }},
  "seaplane_db_deletion_protection": {{ regional_cluster.seaplane_db_deletion_protection | default(true) | tojson }},
  "seaplane_db_skip_final_snapshot": {{ regional_cluster.seaplane_db_skip_final_snapshot | default(false) | tojson }},
  "seaplane_db_performance_insights_enabled": {{ regional_cluster.seaplane_db_performance_insights_enabled | default(true) | tojson }},
  "seaplane_db_monitoring_interval": {{ regional_cluster.seaplane_db_monitoring_interval | default(60) | tojson }},
  "enable_cloudtrail": {{ regional_cluster.enable_cloudtrail | default(true) | tojson }},
  "enable_api_custom_domain": {{ regional_cluster.enable_api_custom_domain | default(false) | tojson }},
  "zone_shard_count": {{ regional_cluster.zone_shard_count | default(1) | tojson }},
  "enable_sns_alerting": {{ observability.sns_alerting.enabled | default(false) | tojson }},
  "enable_sre_tools_gateway": {{ regional_cluster.enable_sre_tools_gateway | default(false) | tojson }},
  "enable_sre_public_access": {{ regional_cluster.enable_sre_public_access | default(false) | tojson }},
  "enable_sre_oidc_auth": {{ regional_cluster.enable_sre_oidc_auth | default(false) | tojson }},
  "sre_oidc_issuer_url": {{ regional_cluster.sre_oidc_issuer_url | default("https://auth.redhat.com/auth/realms/EmployeeIDP") | tojson }},
  "sre_grafana_oidc_client_id": {{ regional_cluster.sre_grafana_oidc_client_id | default("") | tojson }},
  "sre_argocd_oidc_client_id": {{ regional_cluster.sre_argocd_oidc_client_id | default("") | tojson }},
  "sre_prometheus_oidc_client_id": {{ regional_cluster.sre_prometheus_oidc_client_id | default("") | tojson }},
  "sre_thanos_oidc_client_id": {{ regional_cluster.sre_thanos_oidc_client_id | default("") | tojson }},
  "regional_id": "{{ regional_id }}",
  "environment": "{{ environment }}",
  "zoa_lambda_image_tag": {{ regional_cluster.zoa_lambda_image_tag | tojson }},
  "zoa_runner_image_tag": {{ regional_cluster.zoa_runner_image_tag | tojson }},
  "zoa_lambda_source_image": {{ regional_cluster.zoa_lambda_source_image | tojson }},
  "zoa_runner_source_image": {{ regional_cluster.zoa_runner_source_image | tojson }},
  "zoa_boundary_image": {{ ((regional_cluster.zoa_boundary_source_image ~ ':' ~ regional_cluster.zoa_boundary_image_tag) if regional_cluster.zoa_boundary_source_image and regional_cluster.zoa_boundary_image_tag else '') | tojson }},
  "zoa_boundary_session_idle_timeout_seconds": {{ regional_cluster.zoa_boundary_session_idle_timeout_seconds | default(3600) | tojson }},
  "zoa_boundary_session_max_duration_hours": {{ regional_cluster.zoa_boundary_session_max_duration_hours | default(4) | tojson }},
  "zoa_lambda_api_concurrency": {{ regional_cluster.zoa_lambda_api_concurrency | tojson }},
  "zoa_lambda_worker_concurrency": {{ regional_cluster.zoa_lambda_worker_concurrency | tojson }},
  "zoa_lambda_access_concurrency": {{ regional_cluster.zoa_lambda_access_concurrency | tojson }},
  "zoa_access_trusted_assumer_role_names": {{ zoa_access_trusted_assumer_role_names | tojson }},
  "zoa_access_trusted_assumer_role_name_suffixes": {% if ci %}[]{% else %}{{ zoa_access_trusted_assumer_role_name_suffixes | tojson }}{% endif %},{# CI central has no developer operator SAML role. #}
  "worker_node_ami_id": {% if worker_node_ami %}{{ worker_node_ami.id | tojson }}{% else %}""{% endif %},
  "worker_node_root_volume_size": {{ worker_node_root_volume_size | default(50) | tojson }},
  "eph_prefix": "{{ eph_prefix | default('') }}"
}
